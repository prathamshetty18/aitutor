# ==============================================================================
# AI Tutor (HS-210 Harmony) — Root Environment Template
# Copy to backend/.env and frontend/.env.local as needed.
# EVERY value below is a placeholder. Never commit real credentials.
# ==============================================================================

# Backend Server & CORS (comma-separated origins)
FRONTEND_ORIGIN="http://localhost:3000"

# Groq LLM API (Qwen 3.8)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_FORCE_FALLBACK="false"

# Local SQLite & sqlite-vec (plaintext compute cache / RAG corpus — NEVER synced)
DB_PATH="ai_tutor.db"
USE_SQLITE_VEC="true"

# Wellbeing & Early-Warning Distress Thresholds
SENTIMENT_THRESHOLD="-0.2"
ROLLING_WINDOW_DAYS="7"
HOD_EMAIL="hod_counselor@university.edu"

# Audio STT & Embeddings (wav-only avoids an ffmpeg dependency)
ACCEPTED_AUDIO_FORMATS="wav"
WHISPER_MODEL="base"
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# Institutional access control
ALLOWED_EMAIL_DOMAINS="nmamit.in"
REQUIRE_INSTITUTIONAL_DOMAIN="true"

# Supabase — sole IdP (Google OAuth) + cloud ciphertext database
# Dashboard -> Settings -> API. Use placeholder-style values in VCS.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"

# Backend-signed artifacts (generate: openssl rand -hex 32)
JWT_SECRET_KEY="GENERATE_A_RANDOM_32_BYTE_SECRET"

# Frontend (set in frontend/.env.local)
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
