# ==============================================================================
# Backend environment template — placeholder values only. Never commit real keys.
# ==============================================================================

# Server & CORS (comma-separated origins)
FRONTEND_ORIGIN="http://localhost:3000"
ENVIRONMENT="development"

# Supabase — sole IdP (Google OAuth) + cloud ciphertext database
# Dashboard -> Settings -> API
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"

# Institutional access control (students only per current scope)
ALLOWED_EMAIL_DOMAINS="nmamit.in"
REQUIRE_INSTITUTIONAL_DOMAIN="true"

# JWT for backend-signed artifacts (generate: openssl rand -hex 32)
JWT_SECRET_KEY="GENERATE_A_RANDOM_32_BYTE_SECRET"
JWT_ALGORITHM="HS256"

# Groq API Configuration
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_FORCE_FALLBACK="false"

# SQLite & sqlite-vec Configuration (plaintext local compute cache)
DB_PATH="ai_tutor.db"
USE_SQLITE_VEC="true"

# Sentiment & Early-Warning Distress Thresholds
SENTIMENT_THRESHOLD="-0.2"
ROLLING_WINDOW_DAYS="7"
HOD_EMAIL="hod_counselor@university.edu"

# Audio & Models (wav-only avoids ffmpeg dependency)
ACCEPTED_AUDIO_FORMATS="wav"
WHISPER_MODEL="base"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
